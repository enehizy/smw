# Copy to .env and fill in. Never commit .env.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=

# Sender shown on the e-mail. Leave empty to use Resend's test sender (onboarding@resend.dev),
# which can only deliver to the e-mail address that owns the Resend account.
# Once the label's domain is verified in Resend, use e.g. SMW Website <website@yourdomain.com>
CONTACT_FROM_EMAIL=

# --- Content manager (/admin) ---
# Password editors type at /admin. Changing it signs everyone out.
ADMIN_PASSWORD=

# GitHub App that saves edits to the repo (GitHub → Settings → Developer settings → GitHub Apps).
# Repository permission "Contents: Read and write", installed on this repo only.
GITHUB_APP_ID=
# The app's private key (.pem file). Paste it as-is, with \n for line breaks, or base64-encoded.
GITHUB_APP_PRIVATE_KEY=
